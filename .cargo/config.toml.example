# Local build overrides. Copy to `.cargo/config.toml`, which is gitignored.
#
# voxr depends on sibling crates by path. Without this patch cargo resolves
# them from crates.io and the build fails on APIs the published versions lack.
[patch.crates-io]
numr = { path = "../numr" }
boostr = { path = "../boostr" }
splintr = { path = "../splintr" }
regexr = { path = "../regexr" }

# Model fixtures live outside the repo. Point this at your own checkpoint
# directory. Tests that need a real model skip loudly when it is unset, so a
# run without it reports success while checking nothing.
[env]
BOOSTR_MODELS_DIR = "/path/to/models"
